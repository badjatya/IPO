{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset --hard*": "ask",
      "git branch -D*": "ask",
      "git checkout main*": "ask",
      "git switch main*": "ask",
      "pip install*": "ask",
      "pip3 install*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "rm -rf*": "ask"
    },
    "edit": {
      "*": "allow",
      "analysis/*": "deny",
      "reports/*": "deny",
      "data/*": "deny",
      "config/delivery.json": "deny",
      "ROUTINE.md": "deny",
      "CLAUDE.md": "deny",
      ".claude/*": "deny",
      "opencode.json": "deny",
      ".opencode/*": "deny"
    }
  }
}
