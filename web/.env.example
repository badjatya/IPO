# The app's environment variables, named as in docs/tech.md § Configuration and secrets.
# Copy to .env.local (gitignored) and fill in only what the feature you are working on needs.
# Locally, `neon checkout dev` (in web/) writes the database variables for you.

# Neon connection, pooled, a different branch per environment (web/lib/db.ts)
DATABASE_URL=
# The same branch's direct connection, for drizzle-kit migrations (task 007)
DATABASE_URL_UNPOOLED=
# Gemini API key for Ask (task 023)
GEMINI_API_KEY=
# Session signing (task 010)
AUTH_SECRET=
# Fine-grained token that can only dispatch the stock worker workflow (task 022)
GITHUB_DISPATCH_TOKEN=
