{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m ipo_agent.snapshot:*)",
      "Bash(python3 -m ipo_agent.quiet:*)",
      "Bash(python3 -m ipo_agent.outcomes:*)",
      "Bash(python3 -m ipo_agent.trends:*)",
      "Bash(python3 -m ipo_agent.email_render:*)",
      "Bash(python3 -m ipo_agent.rhp:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre-bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post-write"
          }
        ]
      }
    ]
  }
}
